{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/Systema-Sanscriticum/blob/main/docs/schema/ai_native_pedagogy_model.schema.json",
  "title": "AI-native pedagogical design model (Systema-Sanscriticum)",
  "description": "Validator for docs/schema/ai_native_pedagogy_model.yaml. Structural only: it cannot check whether a class assignment is pedagogically right, only that the file says something well-formed. The delegation-matrix invariant (which ai_mode is admissible for which operation_class) is NOT expressible here and is checked by the W1 linter instead.",
  "type": "object",
  "required": ["version", "status", "owner_repo", "vocabularies", "delegation_matrix", "assessment_functions", "operations", "sanskrit_layer", "pilot_norms"],
  "additionalProperties": false,

  "$defs": {
    "rung": { "enum": ["A0", "A1", "A2", "B1", "B2", "C1", "C2"] },
    "operationClass": { "enum": ["constitutive", "enabling", "evidentiary", "logistic"] },
    "aiMode": { "enum": ["perform", "assist", "prepare", "prohibited"] },
    "classByRung": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/rung" },
      "additionalProperties": { "$ref": "#/$defs/operationClass" }
    },
    "modeByRung": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/rung" },
      "additionalProperties": { "$ref": "#/$defs/aiMode" }
    },
    "assetRef": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "description": "Eloquent model names under app/Models where this leaves a record. A rule with no trace is unverifiable by construction.",
      "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
    }
  },

  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "pilot", "adopted", "superseded"] },
    "owner_repo": { "const": "Systema-Sanscriticum" },
    "handoff": { "type": "string", "pattern": "^H\\d+$" },

    "trace_reality": {
      "type": "object",
      "description": "What each contour's data actually holds, measured. Distinct from `trace:` on an operation, which only asserts that a table exists.",
      "required": ["measured_on", "measured_by", "contours"],
      "additionalProperties": false,
      "properties": {
        "measured_on": { "type": "string", "format": "date" },
        "measured_by": { "type": "string" },
        "contours": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["contour", "rows", "answers", "cannot_answer"],
            "additionalProperties": false,
            "properties": {
              "contour": { "type": "string" },
              "rows": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
              "answers": { "type": "string" },
              "cannot_answer": {
                "type": "string",
                "description": "Required. A contour with no stated limit has not been measured, only hoped for."
              },
              "falsified": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },

    "vocabularies": {
      "type": "object",
      "required": ["actor", "operation_class", "ai_mode", "rung"],
      "properties": {
        "actor": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["student", "teacher", "ai", "student+ai", "teacher+ai"] }
        },
        "operation_class": {
          "type": "object",
          "required": ["constitutive", "enabling", "evidentiary", "logistic"],
          "additionalProperties": { "type": "string" }
        },
        "ai_mode": {
          "type": "object",
          "required": ["perform", "assist", "prepare", "prohibited"],
          "additionalProperties": { "type": "string" }
        },
        "rung": { "type": "array", "items": { "$ref": "#/$defs/rung" } }
      }
    },

    "delegation_matrix": {
      "type": "object",
      "required": ["constitutive", "enabling", "evidentiary", "logistic"],
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/aiMode" }
      }
    },

    "assessment_functions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label_ru", "does", "class", "ai_mode", "human_owns", "trace"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^F\\d$" },
          "label_ru": { "type": "string" },
          "label_en": { "type": "string" },
          "does": { "type": "string" },
          "class": { "$ref": "#/$defs/operationClass" },
          "class_for_system": { "$ref": "#/$defs/operationClass" },
          "ai_mode": { "$ref": "#/$defs/aiMode" },
          "ai_mode_exception": {
            "type": "object",
            "required": ["when", "mode"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string" },
              "mode": { "$ref": "#/$defs/aiMode" }
            }
          },
          "human_owns": { "type": "string" },
          "note": { "type": "string" },
          "trace": { "$ref": "#/$defs/trace" }
        }
      }
    },

    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "label_ru", "class_by_rung", "trace"],
        "additionalProperties": false,
        "anyOf": [
          { "required": ["ai_mode"] },
          { "required": ["ai_mode_by_rung"] }
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^op\\.[a-z0-9_]+$" },
          "group": { "enum": ["generation", "analysis", "explanation", "generalization", "assessment", "regulation", "logistics"] },
          "label_ru": { "type": "string" },
          "class_by_rung": { "$ref": "#/$defs/classByRung" },
          "ai_mode": { "$ref": "#/$defs/aiMode" },
          "ai_mode_by_rung": { "$ref": "#/$defs/modeByRung" },
          "must_route_through_asset": { "$ref": "#/$defs/assetRef" },
          "constraint": { "type": "string" },
          "rationale": { "type": "string" },
          "note": { "type": "string" },
          "trace": { "$ref": "#/$defs/trace" }
        }
      }
    },

    "sanskrit_layer": {
      "type": "object",
      "required": ["general_rule", "failure_modes"],
      "additionalProperties": false,
      "properties": {
        "general_rule": { "type": "string" },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["operation", "failure"],
            "additionalProperties": false,
            "properties": {
              "operation": { "type": "string", "pattern": "^op\\.[a-z0-9_]+$" },
              "failure": { "type": "string" }
            }
          }
        }
      }
    },

    "pilot_norms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pilot", "statement", "probe", "falsified_if"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^N\\d+$" },
          "pilot": { "type": "boolean" },
          "statement": { "type": "string" },
          "functions": { "type": "array", "items": { "type": "string", "pattern": "^F\\d$" } },
          "probe": { "type": "string", "pattern": "^VERIFICATION P\\d+$" },
          "falsified_if": {
            "type": "string",
            "description": "Required. A norm with no stated falsifier is an opinion, not a pilot norm."
          }
        }
      }
    },

    "observed_ai_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface", "domain", "model_verdict", "action"],
        "additionalProperties": false,
        "properties": {
          "surface": { "type": "string" },
          "domain": { "type": "string" },
          "model_verdict": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    }
  }
}
