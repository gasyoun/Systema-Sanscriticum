      "parameters": {
        "jsCode": "const plMap = {};\nfor (const p of $('Get many playlists').all()) {\n  if (p.json && p.json.id) plMap[p.json.id] = (p.json.snippet && p.json.snippet.title) || '';\n}\nconst idRe = /(?:youtu\\.be\\/|[?&]v=|\\/live\\/|\\/shorts\\/|\\/embed\\/)([A-Za-z0-9_-]{11})/;\nconst existing = new Set();\nfor (const row of $('╨б╤Г╤Й╨╡╤Б╤В╨▓╤Г╤О╤Й╨╕╨╡ ╤Б╤Б╤Л╨╗╨║╨╕').all()) {\n  const j = row.json || {};\n  for (const val of [...Object.keys(j), ...Object.values(j)]) {\n    const m = String(val).match(idRe);\n    if (m) existing.add(m[1]);\n  }\n}\nconst out = [];\nconst seen = new Set();\nfor (const item of $input.all()) {\n  const s = (item.json && item.json.snippet) || {};\n  const id = s.resourceId && s.resourceId.videoId;\n  if (!id) continue;\n  const title = s.title || '';\n  if (title === 'Deleted video') continue;\n  if (existing.has(id) || seen.has(id)) continue;\n  seen.add(id);\n  const th = s.thumbnails || {};\n  const thumb = ((th.maxres || th.standard || th.high || th.medium || th.default || {}).url) || '';\n  out.push({ json: { videoId: id, title: title, description: s.description || '', thumb: thumb, playlistId: s.playlistId || '', playlistTitle: plMap[s.playlistId] || '' }});\n}\nreturn out;\n"
