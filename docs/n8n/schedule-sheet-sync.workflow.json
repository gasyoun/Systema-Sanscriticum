        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Берём снимок расписания напрямую из вебхука (он переживает шаг \"Очистить лист\").\n// body.schedules приходит из ListSchedules::syncToSheet() в Laravel.\nconst body = $('Webhook').first().json.body ?? {};\nconst schedules = Array.isArray(body.schedules) ? body.schedules : [];\n\nreturn schedules.map((s, i) => ({\n  json: {\n    '№': i + 1,\n    'Дата': s.date ?? '',\n    'День недели': s.weekday ?? '',\n    'Время': s.time ?? '',\n    'Занятие': s.title ?? '',\n    'Группа': s.group ?? '',\n    'Курс': s.course ?? '',\n    'Ссылка': s.link ?? '',\n  },\n}));"
      },
