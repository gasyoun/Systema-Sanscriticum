    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"error\": \"unauthorized\" } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "respond-401",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/search/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ 'repo:gasyoun/Systema-Sanscriticum is:issue is:open in:title \"[soft-alert] ' + ($('Webhook soft-alert').first().json.body.scope || 'unknown') + ' ' + ($('Webhook soft-alert').first().json.body.fingerprint || '').slice(0,8) + '\"' }}"
            },
            {
              "name": "per_page",
              "value": "30"
            }
          ]
        },
        "options": {}
      },
      "id": "github-search-open",
      "name": "GitHub search open issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, -80],
      "notes": "H8562 lookup-before-create: the search phrase must stay byte-identical to the created title `[soft-alert] {scope} {fingerprint[:8]}`. Live wiring uses the env token SOFT_ALERT_GITHUB_TOKEN (see docs/ops/SOFT_ALERT_WEBHOOK.md); the skeleton keeps the githubApi credential."
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total_count || 0 }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-existing-open",
      "name": "IF existing open issue",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/gasyoun/Systema-Sanscriticum/issues/{{$json.items[0].number}}/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: `Same fingerprint re-fired — staying in this issue (H8562 dedup; sender flap grace landed in Systema PR).\n\n**When:** ${$('Webhook soft-alert').first().json.body.occurred_at}\n**Failures:**\n${($('Webhook soft-alert').first().json.body.failures || []).map(f => `- ${f.message}`).join('\n')}` }) }}",
        "options": {}
      },
      "id": "github-comment-existing",
      "name": "GitHub comment on existing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, -200],
      "notes": "Converge: a repeat delivery of an ACTIVE fingerprint comments here instead of opening a new issue."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"deduped\": true, \"issue\": $('GitHub search open issue').first().json.items[0].html_url || null } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-200-dedup",
      "name": "Respond 200 deduped",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, -200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/gasyoun/Systema-Sanscriticum/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: `[soft-alert] ${$('Webhook soft-alert').first().json.body.scope || 'unknown'} ${($('Webhook soft-alert').first().json.body.fingerprint || '').slice(0,8)}`, body: `## Soft cabinet alert\\n\\n**Scope:** ${$('Webhook soft-alert').first().json.body.scope}\\n**Fingerprint:** \\`${$('Webhook soft-alert').first().json.body.fingerprint}\\`\\n**When:** ${$('Webhook soft-alert').first().json.body.occurred_at}\\n\\n### Failures\\n${($('Webhook soft-alert').first().json.body.failures || []).map(f => `- ${f.message}`).join('\\n')}\\n\\n### Playbook\\nhttps://github.com/gasyoun/Systema-Sanscriticum/blob/main/docs/SERVER_SOFT_ALERT_PLAYBOOK.md\\n\\n### Suggested (agent)\\n\\`\\`\\`\\nssh root@193.232.229.92\\ncd /var/www/html\\n${$('Webhook soft-alert').first().json.body.suggested?.diagnose || 'php artisan ops:soft-remediate --dry-run --json'}\\n\\`\\`\\`\\n\\nAssignee: @pe4kinsmart-tech\\nLabel: ops-soft-alert\\nH8562 — do not auto-apply hard fuse clears.`, labels: ['ops-soft-alert'], assignees: ['pe4kinsmart-tech'] }) }}",
        "options": {}
      },
      "id": "github-issue",
      "name": "GitHub create issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, -40],
      "notes": "Reachable ONLY from the IF-existing false branch (no open issue with this title). H8562: the input of this node is the search response, so the body is referenced via $('Webhook soft-alert') explicitly. Title must stay byte-identical to the search phrase."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/search/issues",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ 'repo:gasyoun/Systema-Sanscriticum is:issue is:open in:title \"[soft-alert] ' + ($('Webhook soft-alert').first().json.body.scope || 'unknown') + ' ' + ($('Webhook soft-alert').first().json.body.fingerprint || '').slice(0,8) + '\"' }}"
            },
            {
              "name": "per_page",
              "value": "30"
            }
          ]
        },
        "options": {}
      },
      "id": "github-reconcile-search",
      "name": "GitHub reconcile search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, -40],
      "notes": "H8562 post-create reconciliation: a concurrent delivery may have created a second issue with the same title inside the create race window. Re-run the search AFTER our create so both race orders converge."
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ (($json.total_count || 0) > 1) && ($json.items || []).some(i => i.number < $('GitHub create issue').first().json.number) }}"
            }
          ]
        }
      },
      "id": "if-we-are-duplicate",
      "name": "IF we are the duplicate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1440, -40],
      "notes": "Lowest-number-wins: if any open issue with the same title has a LOWER number than ours, ours is the duplicate (created second inside the race window). Both concurrent orders converge to the earlier issue — no iteration needed."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/gasyoun/Systema-Sanscriticum/issues/{{ $('GitHub create issue').first().json.number }}/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: `Closed as duplicate of #${($json.items || []).filter(i => i.number < $('GitHub create issue').first().json.number).sort((a, b) => a.number - b.number)[0].number} — concurrent soft-alert deliveries converge on one issue (H8562).` }) }}",
        "options": {}
      },
      "id": "github-comment-duplicate",
      "name": "GitHub comment duplicate note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1680, -120]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.github.com/repos/gasyoun/Systema-Sanscriticum/issues/{{ $('GitHub create issue').first().json.number }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ state: 'closed', state_reason: 'completed' }) }}",
        "options": {}
      },
      "id": "github-close-duplicate",
      "name": "GitHub close duplicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1920, -120],
      "notes": "Closes exactly OUR own just-created issue — never a rival's. A newer rival closes itself by the same rule when its own reconciliation runs."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"converged\": true, \"issue\": $('GitHub create issue').first().json.html_url || null, \"converged_into\": ($json.items || []).filter(i => i.number < $('GitHub create issue').first().json.number).sort((a, b) => a.number - b.number)[0].html_url || null } }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "respond-202-converged",
      "name": "Respond 202 converged",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2160, -120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"issue\": $json.html_url || null } }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "respond-202",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1680, 20]
    }
  ],
