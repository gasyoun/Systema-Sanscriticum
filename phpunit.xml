<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap_worktree.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Worktree .env often has empty APP_KEY; Livewire list-page smokes need encrypt. -->
        <env name="APP_KEY" value="base64:2fl+KtvkdphvQyEfjOzf3mJCEJnA8otCLK5LpM/V8Xw="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Userbot выключен в тестах (локальный .env может ставить =true); тесты,
             которым он нужен, включают его через config() явно. Иначе class_exists
             на реальном danog\MadelineProto\API регистрирует shutdown-хендлер,
             роняющий amp на teardown под Windows. -->
        <env name="TELEGRAM_SUPPORT_ENABLED" value="false"/>
        <!-- H1914 server guards: CI is Linux but not prod — never audit host systemd/cron. -->
        <env name="SERVER_GUARDS_VERIFY" value="false"/>
        <env name="CABINET_PROBE_CHECK_GUARDS" value="false"/>
        <!-- Outbound payment-TLS probe: tests must never hit the real acquiring API
             (each test enables it explicitly with Http::fake). -->
        <env name="CABINET_PROBE_CHECK_PAYMENT_TLS" value="false"/>
    </php>
</phpunit>
