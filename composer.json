{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/gasyoun/filament-kanban"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gasyoun/filament-fullcalendar"
        }
    ],
    "require": {
        "php": "^8.3",
        "awcodes/filament-curator": "^3.7",
        "awcodes/filament-tiptap-editor": "^3.5",
        "barryvdh/laravel-dompdf": "^3.1",
        "danog/madelineproto": "^8.7",
        "filament/filament": "^3.0",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^13.24.0",
        "laravel/horizon": "^5.46",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.11",
        "laravel/tinker": "^3.0",
        "league/flysystem-webdav": "^3.31",
        "maxmind-db/reader": "1.13.1",
        "mokhosh/filament-kanban": "dev-l13-compatibility as 2.11.0",
        "nelexa/zip": "^4.0",
        "pxlrbt/filament-excel": "^2.5",
        "saade/filament-fullcalendar": "dev-l13-compatibility as 3.2.4",
        "socialiteproviders/vkontakte": "^5.1",
        "socialiteproviders/yandex": "^4.1",
        "spatie/laravel-backup": "^10.3",
        "symfony/css-selector": "^7.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/http-client": "^7.4",
        "symfony/mailgun-mailer": "^7.4",
        "symfony/postmark-mailer": "^7.4"
    },
    "require-dev": {
        "brianium/paratest": "^7",
        "fakerphp/faker": "^1.9.1",
        "laravel/dusk": "^8.6",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php scripts/silence_madeline_windows_polyfill.php"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false,
        "audit": {
            "block-insecure": true
        },
        "platform": {
            "php": "8.3.0",
            "ext-pcntl": "8.3.0",
            "ext-posix": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
