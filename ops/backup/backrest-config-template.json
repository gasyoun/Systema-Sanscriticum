{
  "_comment": "DEPRECATED historical template: do not apply; use backrest-config-safe-template.json. Scheduled checks over append-only SFTP leave an exclusive lock and block hourly backups.",
  "version": 6,
  "modno": 1,
  "instance": "vps-samskrte92",
  "repos": [
    {
      "id": "systema-sftp",
      "uri": "sftp:restic-push@192.168.200.91:/systema",
      "guid": "<restic cat config --json -> id>",
      "env": [
        "RESTIC_PASSWORD_FILE=/root/.restic-pass"
      ],
      "flags": [],
      "checkPolicy": {
        "schedule": { "cron": "7 7 * * 0", "clock": "CLOCK_UTC" }
      },
      "autoUnlock": false,
      "hooks": [
        {
          "conditions": ["CONDITION_ANY_ERROR"],
          "onError": "ON_ERROR_IGNORE",
          "actionCommand": {
            "command": "/usr/local/sbin/backrest-hook-notify.sh {{ .ShellEscape .Task }} {{ .ShellEscape .Error }}"
          }
        }
      ]
    }
  ],
  "plans": [],
  "auth": {
    "disabled": false,
    "users": [
      { "name": "mg", "passwordBcrypt": "<base64(bcrypt-hash)>" }
    ]
  }
}
