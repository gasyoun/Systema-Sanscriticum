# /root/.restic-s3.env — Yandex Object Storage immutable offsite (H3175 → H3413)
#
# АКТИВАЦИЯ ПО РЕШЕНИЮ MG 24-08-2026: запуск ≈24-09-2026 (месяц после одобрения).
# До этого файла на боксе быть не должно — restic-нога честно пишет SKIP.
#
# Как заполнять на .92 (root):
#   1. Создать бакет в https://console.cloud.yandex.ru/ с Object Lock:
#      retention 400 дней, mode governance.
#   2. Создать статический ключ сервисного аккаунта, права ТОЛЬКО PutObject
#      (delete запрещён — иначе WORM не иммутабелен).
#   3. cp ops/backup/restic-s3.env.example /root/.restic-s3.env
#      nano /root/.restic-s3.env   # вставить значения ниже
#      chmod 600 /root/.restic-s3.env
#   4. bash /usr/local/sbin/systema-restic-s3-verify.sh --init
#      Ожидаемо: 1.1 PASS (удаление отказом AccessDenied), 1.2 IMMUTABLE=yes,
#      затем списки снапшотов обоих репо (1.3). Дальше hourly tick сам подхватит.
#
# Никогда не коммитить реальные значения. Источник контракта ключей:
# ops/backup/RUN_LOG_H3175_WAVE1_23-08-2026.md («Owner-side residual»).

RESTIC_S3_BUCKET=
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=

# Опционально — админ-ключ ТОЛЬКО для верификации immutability (критерий 1.2b,
# проверка отказа в удалении). Прод-пуш его не использует.
S3_ADMIN_ACCESS_KEY_ID=
S3_ADMIN_SECRET_ACCESS_KEY=
