{
  "_comment": "Current vps92 template. No Backrest check schedule: an exclusive check lock cannot be removed through append-only SFTP and blocks hourly backups. Run integrity checks only locally on vps91 with lock-removal rights. Replace placeholders before use; never commit credentials.",
  "version": 6,
  "modno": 1,
  "instance": "vps-samskrte92",
  "repos": [
    {
      "id": "systema-sftp",
      "uri": "sftp:restic-push@192.168.200.91:/systema",
      "guid": "<restic cat config --json -> id>",
      "env": [
        "RESTIC_PASSWORD_FILE=/root/.restic-pass"
      ],
      "flags": [],
      "autoUnlock": false,
      "hooks": [
        {
          "conditions": [
            "CONDITION_ANY_ERROR"
          ],
          "onError": "ON_ERROR_IGNORE",
          "actionCommand": {
            "command": "/usr/local/sbin/backrest-hook-notify.sh {{ .ShellEscape .Task }} {{ .ShellEscape .Error }}"
          }
        }
      ]
    }
  ],
  "plans": [],
  "auth": {
    "disabled": false,
    "users": [
      {
        "name": "mg",
        "passwordBcrypt": "<base64(bcrypt-hash)>"
      }
    ]
  }
}
