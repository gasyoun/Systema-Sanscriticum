# ops/backup/archive-encryption.env — секрет шифрования spatie-архива (H6306)
#
# ШАБЛОН: реальный файл НИКОГДА не коммитится (см. .gitignore:
# ops/backup/archive-encryption.env). Значение пароля в чаты/логи/отчёты
# не выносится — только факт наличия.
#
# Контракт: config/backup.php `'password' => env('BACKUP_ARCHIVE_PASSWORD')`
# + `'encryption' => 'default'` (AES-256, libzip). Без непустого значения:
#   - SplitUploadToYandex ОТКАЗЫВАЕТ выгрузку/докатку частей off-site;
#   - deploy:config-preflight красит forward-деплой прода (hard-fail).
#
# Как заполнить на .92 (root) — ОТДЕЛЬНАЯ gated-op, по слову MG:
#   1. Сгенерировать пароль: `openssl rand -base64 32`
#      (хранить в менеджере паролей MG — это ключ ВСЕЙ off-site истории).
#   2. Вставить строку в /var/www/html/.env:
#      BACKUP_ARCHIVE_PASSWORD=<сгенерированное значение>
#   3. cd /var/www/html && php artisan config:cache
#   4. Проверка (без чтения значения):
#      php -r 'require "vendor/autoload.php"; ...' — или просто:
#      grep -c "^BACKUP_ARCHIVE_PASSWORD=." .env   # → 1
#   5. Следующий backup:run создаст зашифрованный архив; части на Диске
#      пойдут только от него. Исторические части НЕ трогаем и НЕ
#      перезаливаем (см. runbook).
#
# Откат: убрать строку из .env + config:cache — выгрузка off-site встанет
# (это безопасный отказ, не потеря), local-копия и restic-нога продолжат.

BACKUP_ARCHIVE_PASSWORD=
