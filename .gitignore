# Публикуемые ассеты пакетов — build-артефакты, пересобираются на деплое
# (deploy.sh: `php artisan filament:assets`), в git НЕ хранятся. Хранение
# приводило к дрейфу: закоммиченные ассеты устаревали относительно версии
# пакета и ломали Livewire-гидрацию (вход в админку «поле обязательно»).
# Livewire 3 отдаёт свой livewire.js маршрутом (@livewireScripts) —
# public/vendor/livewire не используется приложением.
/public/css/filament
/public/js/filament
/public/vendor/livewire
/storage/*.key
# Per-worker storage под `php artisan test --parallel` (ParallelSafePath, H3156).
/storage/parallel
/vendor
.env
.env.backup
.env.production
.env.magnet.local
.env.*.local
/lecture-builder/.env
/lecture-builder/.venv/
__pycache__/
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

