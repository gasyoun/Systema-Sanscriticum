# Copy these values into the production .env. Never commit the completed file.
TELEGRAM_BUSINESS_BOT_ENABLED=true
TELEGRAM_BUSINESS_BOT_TOKEN=
TELEGRAM_BUSINESS_WEBHOOK_SECRET=
TELEGRAM_BUSINESS_BOT_USERNAME=

# The bot must be administrator in both source channels. Numeric IDs are most
# robust; these public usernames are accepted while Telegram includes them in
# the incoming channel_post update.
TELEGRAM_BUSINESS_STORY_SOURCES=@samskrte,@samskrtamru
TELEGRAM_BUSINESS_STORY_ACTIVE_PERIOD=86400
TELEGRAM_BUSINESS_STORY_CAPTION=
TELEGRAM_BUSINESS_STORY_FFMPEG_BINARY=ffmpeg
