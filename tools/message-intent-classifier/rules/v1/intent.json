{
  "version": 1,
  "rules": [
    {
      "plane": "intent",
      "category": "trial_request",
      "priority": 10,
      "patterns": [
        "пробн(ое|ый|ые)( занятие| урок)?",
        "бесплатн[а-я]* (занятие|вводн[а-я]*)|вводные занятия",
        "ознакомительн[а-я]*",
        "можно попробовать"
      ],
      "negations": [],
      "enabled": true,
      "source": "FAQ пробное_занятие (В9 мост); раньше learn_start"
    },
    {
      "plane": "intent",
      "category": "buy_signal",
      "priority": 15,
      "patterns": [
        "готов(а)? купить|хочу купить|куплю курс",
        "хочу оплатить|оплачу|выставите счет|готов(а)? оплатить"
      ],
      "negations": [],
      "enabled": true,
      "source": "C-этап воронки (оплата)"
    },
    {
      "plane": "intent",
      "category": "price_query",
      "priority": 20,
      "patterns": [
        "сколько стоит|сколько.{0,24}стои",
        "(?<![а-я])цен[ауыое](?![а-я])|стоимост[а-я]*",
        "прайс",
        "тариф[а-я]*"
      ],
      "negations": [],
      "enabled": true,
      "source": "live/цены note (тема №3 по весу). H3526: + answerer.py _live_intent price-набор — «прайс», «тариф»; «стоит ли» остаётся в objection b4 (FAQ-карта), не дублируется"
    },
    {
      "plane": "intent",
      "category": "schedule_query",
      "priority": 25,
      "patterns": [
        "когда (занятие|урок|старт|начало|будет|следующ[а-я]*)",
        "расписан[а-я]*|во ?сколько|в какое время|какой день",
        "день недели|дни занятий",
        "начало курса",
        "закончится"
      ],
      "negations": [],
      "enabled": true,
      "source": "live/расписание (тема №1 по весу, 141). H3526: + answerer.py _live_intent schedule-набор — день недели, дни занятий, начало курса, закончится; голое «когда» и «старт» остаются в topic-schedule / objection-b6 легаси-руках"
    },
    {
      "plane": "intent",
      "category": "catalog_browse",
      "priority": 30,
      "patterns": [
        "какие курсы|какие есть курсы|курсы есть",
        "каталог|список курсов|что изучаете|что преподаете",
        "что идет|что сейчас"
      ],
      "negations": [],
      "enabled": true,
      "source": "live/каталог (маршрутизатор выбора). H3526: + answerer.py _live_intent catalog-фразы «что идет», «что сейчас»"
    },
    {
      "plane": "intent",
      "category": "learn_start",
      "priority": 35,
      "patterns": [
        "хочу научиться|хочу изучать|хочу учить|хочу начать",
        "с чего начать|записаться на курс|запишусь на курс",
        "мечтаю читать|начать заниматься"
      ],
      "negations": [],
      "enabled": true,
      "source": "с_чего_начать (главная задача воронки: 20% -> 71%)"
    },
    {
      "plane": "intent",
      "category": "complaint",
      "priority": 40,
      "patterns": [
        "жалуюсь|жалоба|возмутительн|неприемлемо|безобрази",
        "верните деньги|обман|мошенник|игнорируете"
      ],
      "negations": [],
      "enabled": true,
      "source": "эскалационный класс поддержки"
    },
    {
      "plane": "intent",
      "category": "spam_noise",
      "priority": 45,
      "patterns": [
        "отписаться|рассылк[а-я]*|реклам[а-я]*|(?<![а-я])спам",
        "промоакция|акция только"
      ],
      "negations": [],
      "enabled": true,
      "source": "шумовой класс v1 seed"
    },
    {
      "plane": "intent",
      "category": "help_menu",
      "priority": 50,
      "patterns": [
        "меню",
        "что ты умеешь",
        "список команд|какие команды",
        "(?<![a-z])(help|menu)(?![a-z])"
      ],
      "negations": [],
      "enabled": true,
      "source": "H3526: StudentSelfService HELP_PHRASES (/help, /menu, меню, что ты умеешь, список команд, какие команды) — запрос справочного меню бота. Слэш запрещён движком (PCRE-разделитель), поэтому /help и /menu выражены без слэша с латинскими границами."
    }
  ]
}
