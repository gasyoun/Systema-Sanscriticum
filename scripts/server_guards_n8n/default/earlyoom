# MANAGED FILE — scripts/server_guards_apply.sh --profile n8n.
# Пороги — из scripts/server_guards_n8n.conf.
#
# .91 (samskrtam50), 25-08-2026. Машина с 8 ГиБ памяти, своп 2047/2048 МиБ —
# то есть 100 %, — и БЕЗ earlyoom вообще. Это ровно та предпосылка, из которой
# 24-07 и 28-07 выросли два зависания .92: ядро уходит в reclaim livelock и
# перестаёт отвечать раньше, чем срабатывает его собственный OOM-killer.
# Разница в том, что .92 к тому моменту уже имела earlyoom, а .91 не имеет
# ничего — и своп у неё выбран досуха УЖЕ СЕЙЧАС, в штатном режиме.
#
#  -r 60      писать состояние памяти раз в 60 с — на этой машине это
#             ЕДИНСТВЕННАЯ история памяти, которая вообще появится до memwatch
#  -m 10,5    SIGTERM ниже 10 % доступной (~820 МиБ), SIGKILL ниже 5 % (~410 МиБ)
#  --avoid    список ДРУГОЙ, чем на .92, и это не косметика: здесь машину держат
#             dockerd/containerd/sshd, а продукт — node (n8n) и caddy
#  --prefer   выбран по замеру: 7.3 ГиБ /tmp/hindi_audio + 452 МиБ /tmp/whisvenv
#             оставлены ASR-конвейером; именно этот класс здесь разгоняется.
#             Контейнеры в --prefer НЕ попадают сознательно — у них теперь свой
#             cgroup-потолок, и разогнавшийся n8n упрётся в него, а не в earlyoom.
#
# NOTE: кавычек вокруг регулярок нет. systemd режет значение по пробелам и
# передаёт слова буквально; кавычки уехали бы в earlyoom частью шаблона.
EARLYOOM_ARGS="-r @@EARLYOOM_REPORT_INTERVAL@@ -m @@EARLYOOM_TERM_PERCENT@@,@@EARLYOOM_KILL_PERCENT@@ --avoid @@EARLYOOM_AVOID_RE@@ --prefer @@EARLYOOM_PREFER_RE@@"
