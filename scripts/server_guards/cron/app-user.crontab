# MANAGED FILE — installed by scripts/server_guards_apply.sh as the crontab of
# @@APP_USER@@. Edit the repo copy (scripts/server_guards/cron/app-user.crontab),
# never `crontab -e` on the server: guards:verify reports the difference.
#
# Systema Sanscriticum — планировщик и сторожа.
#
# Планировщик идёт через systema-schedule-run.sh, НЕ через голый
# `php artisan schedule:run`: голая форма копила по ~200 МБ PHP-цепочки в минуту
# всякий раз, когда команда шла дольше 60 с, чем и выело память 23-07 и 28-07-2026
# (journald: "cron.service: killed by the OOM killer").
#
# Сторожа вынесены ОТДЕЛЬНЫМИ строками сознательно. 28-07 один заход
# telegram-support:sync завис на 2 ч 54 мин и держал schedule:run; cabinet:probe
# стоит `*/15` ВНУТРИ того же schedule:run, поэтому не выполнился ни разу, и
# сообщение в Telegram не ушло — сторож умер раньше сайта. Своя строка = своя судьба.
#
# См. docs/server-resource-guards.md
HOME=/tmp
* * * * * /usr/local/sbin/systema-schedule-run.sh >> @@APP_DIR@@/storage/logs/schedule.log 2>&1
@@WATCHDOG_CABINET_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "cabinet:probe" cabinet @@WATCHDOG_CABINET_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1
@@WATCHDOG_LOGS_WATCH_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "logs:error-watch" logs-watch @@WATCHDOG_LOGS_WATCH_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1
@@WATCHDOG_HEARTBEAT_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "heartbeat:ping" heartbeat @@WATCHDOG_HEARTBEAT_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1

# H4194 guard pack (docs/GUARD_PACK_INSTALL.md): RAM/swap/load, queue-lag,
# admin-count + webroot .php inventory — none of it read by cabinet:probe.
@@WATCHDOG_RESOURCES_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "guards:resources" guard-resources @@WATCHDOG_RESOURCES_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1
@@WATCHDOG_QUEUE_LAG_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "guards:queue-lag" guard-queue-lag @@WATCHDOG_QUEUE_LAG_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1
@@WATCHDOG_COMPROMISE_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "guards:compromise-integrity" guard-compromise @@WATCHDOG_COMPROMISE_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1

# H4672 money-axis SLI: mocked webhook only, never a live bank charge (see
# config/money_sli.php + features.money_sli_synthetic_pay/_hourly_reconcile,
# both default OFF — command is a no-op until the flag is flipped).
@@WATCHDOG_MONEY_SLI_DAILY_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "money:sli-synthetic-pay" money-sli-daily @@WATCHDOG_MONEY_SLI_DAILY_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1
@@WATCHDOG_MONEY_SLI_HOURLY_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "money:sli-hourly-reconcile" money-sli-hourly @@WATCHDOG_MONEY_SLI_HOURLY_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1

# H5452: дайджест открытых подсказок куратору 09:00 Europe/Moscow (= 06:00 UTC,
# сервер UTC). Своя строка — не schedule:run; инертна, пока
# SUPPORT_HINT_DAILY_DIGEST=false.
@@WATCHDOG_HINTS_DIGEST_SCHEDULE@@ /usr/local/sbin/systema-watchdog-run.sh "support:hints-digest" hints-digest @@WATCHDOG_HINTS_DIGEST_MAX_SECONDS@@ >> @@APP_DIR@@/storage/logs/watchdog.log 2>&1

# care-digest: напоминание в Отдел заботы (@nastya) каждые 2 дня в 11:00 MSK —
# ежедневный запуск 08:00 UTC + гейт 46ч внутри скрипта; своя строка = своя судьба.
# Спасено из живого crontab .92 24-09-2026 (H5452 apply): строка жила только
# на боксе, первый apply стёр бы её — управляемые строки живут здесь.
0 8 * * * /usr/bin/php /usr/local/share/systema-care-digest.php >> /var/www/html/storage/logs/care-digest.log 2>&1
