# Capacitor cabinet host — config-driven, never hardcoded in source.
# Copy this file to `.env` and fill in the real hosts, then `npm run sync`.

# Which environment the build targets: staging | prod
CAP_ENV=staging

# Cabinet hosts per environment (the WebView loads this URL; login/courses/video/chat
# are the existing responsive web cabinet, shown in the WebView — nothing rebuilt).
CAP_URL_STAGING=https://staging.samskrte.ru
CAP_URL_PROD=https://samskrte.ru

# Allow http:// (cleartext) — staging only, opt-in. Prod is always HTTPS.
# Set to 1 only when pointing staging at a local http tunnel / dev box.
CAP_ALLOW_CLEARTEXT=0
