APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: mailpit catches everything, nothing leaves the machine.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Per-minute send throttle (H1449 A2) — a safety valve so a bad segment/loop
# can never blast a mailbox provider. Env-backed, never hardcode.
MAIL_THROTTLE_PER_MINUTE=30
# PRODUCTION: must NOT be the above — `php artisan mail:preflight` rejects this
# shape outside APP_ENV=local. See docs/mail-esp.md. D6 ruling (H1449): the
# default transport is a REAL MAILBOX over SMTP (mail.ru / Yandex 360), not an
# ESP — Laravel's generic `smtp` mailer already covers this with no extra
# package. The campaign engine (H1449 W1b) is transport-agnostic, so this can
# be overridden later to an ESP-as-relay (Postmark/Mailgun, already installed)
# without touching any campaign-engine code if staging deliverability is poor.
# MAIL_MAILER=smtp
# MAIL_HOST=<mailbox-smtp-host, e.g. smtp.mail.ru or smtp.yandex.ru>
# MAIL_PORT=587
# MAIL_USERNAME=<mailbox-address, e.g. noreply@yourdomain.ru>
# MAIL_PASSWORD=<mailbox-password-or-app-password>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="<verified sender on an SPF+DKIM+DMARC domain>"
# MAIL_FROM_NAME="${APP_NAME}"

# S3-совместимое объектное хранилище для тяжёлых медиа (H1345).
# Пока НЕ включено: на 19-07-2026 всё storage/app занимает ~20 МБ, выносить нечего.
# Триггеры включения и порядок переноса — docs/ROADMAP_MEDIA_STORAGE_2026_2028.md.
#
# Провайдер выбирается парой ENDPOINT+REGION, диск один (config/filesystems.php):
#   VK Cloud:  AWS_ENDPOINT=https://hb.ru-msk.vkcloud-storage.ru   AWS_DEFAULT_REGION=ru-msk
#   Yandex:    AWS_ENDPOINT=https://storage.yandexcloud.net        AWS_DEFAULT_REGION=ru-central1
# Обоим нужен AWS_USE_PATH_STYLE_ENDPOINT=true и ЗАКРЫТЫЙ bucket
# (публичный bucket = доступ к работам студентов по ссылке без проверки прав).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Слежка за ростом хранилища (H1345) — пороги в config/storage_watch.php,
# ежедневная команда `storage:check` алертит админов при выходе за них.
STORAGE_WATCH_TOTAL_MB=8000
STORAGE_WATCH_WARN_RATIO=0.8
STORAGE_WATCH_MIN_FREE_DISK_MB=2048

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Laravel Reverb (live-chat WebSocket transport, H536). Set BROADCAST_DRIVER=reverb
# and fill these once the Reverb server is deployed on the host (MG/Ivan deploy step,
# see DEPLOY_QUEUE.md). While VITE_REVERB_APP_KEY is empty the client Echo stays off.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Учётные данные суперадмина (используются DatabaseSeeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# n8n webhook для выгрузки расписания в Google Таблицу (кнопка в разделе «Расписание»).
# Направление строго одностороннее: приложение шлёт снимок расписания, n8n пишет в лист.
N8N_SCHEDULE_SHEET_WEBHOOK=

# Секрет входящего вебхука «лид дошёл до шага бота» (POST /api/webhooks/lead-step).
# n8n шлёт его в заголовке X-Webhook-Secret. Пусто → эндпоинт отвечает 403 (выключен).
N8N_LEAD_STEP_SECRET=

# Клип-маркетинг (H1452): «нарежь лекцию» — исходящий вебхук в n8n (URL + секрет,
# X-Webhook-Secret) и секрет входящего callback-а (POST /api/webhooks/lecture-clip-callback).
# Флаг CLIP_MARKETING_ENABLED (config/features.php) должен быть true, иначе оба пути неактивны.
CLIP_MARKETING_ENABLED=false
N8N_CLIP_EXTRACT_WEBHOOK=
N8N_CLIP_EXTRACT_SECRET=
N8N_CLIP_CALLBACK_SECRET=

# Telegram (основной бот: служебные чаты — кураторы/маркетологи/онбординг).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Отдельный бот для СТУДЕНЧЕСКОГО КАБИНЕТА: привязка аккаунта, ИИ-куратор и
# личные уведомления студенту. Пусто → используется основной бот выше.
# Вебхук этого бота направить на /api/telegram/webhook.
STUDENT_TELEGRAM_BOT_TOKEN=
STUDENT_TELEGRAM_BOT_USERNAME=
# Личный chat_id админа для алертов от ассистента/ВК-бота.
ADMIN_TELEGRAM_ID=
# Chat_id общего чата кураторов: туда шлются уведомления по всем оплатам,
# броням, обещаниям и рассрочкам. Бот должен быть добавлен в этот чат.
# Пусто → curator-уведомления отключены.
TELEGRAM_CURATORS_CHAT_ID=
# Chat_id чата онбординга: «первый вход в кабинет» + еженедельная сводка
# по оплатившим, но не зашедшим. Бот должен быть добавлен в этот чат.
# Пусто → онбординг-уведомления отключены.
TELEGRAM_ONBOARDING_CHAT_ID=

# Telegram support-account analytics (Telegram Client API, MadelineProto-ready).
# Disabled by default; the dashboard can still show imported/test analytics.
TELEGRAM_SUPPORT_ENABLED=false
TELEGRAM_SUPPORT_API_ID=
TELEGRAM_SUPPORT_API_HASH=
TELEGRAM_SUPPORT_SESSION=storage/app/telegram-support/session.madeline
TELEGRAM_SUPPORT_HISTORY_LIMIT=50
TELEGRAM_SUPPORT_DIALOG_LIMIT=20
TELEGRAM_SUPPORT_PROFILE_BACKFILL_LIMIT=20
# Tests may override this; production should keep the default MadelineProto API.
TELEGRAM_SUPPORT_CLIENT_CLASS=

# ── Telegram-харвестер санскрит-корпуса (Track B) ────────────────────────
# Делит ОДНУ MTProto-сессию с support-синком (TELEGRAM_SUPPORT_API_ID/HASH/
# SESSION выше). Параллельный запуск сериализуется локом 'madeline-session'
# (вторая команда выходит session_busy), но лучше не гонять их встык вручную.
# Discovery диалогов: telegram-harvest:peers.
TELEGRAM_HARVEST_ENABLED=false
# Кого харвестить: @username или numeric id через запятую (см. вывод :peers).
TELEGRAM_HARVEST_PEERS=
# Либо путь к файлу с JSON-массивом пиров (["@a", -1001234567890, ...]) — удобнее
# для длинных списков. МЁРЖИТСЯ со списком выше (не заменяет его).
TELEGRAM_HARVEST_PEERS_FILE=
# Кап сообщений за проход на пира (суммарный: Telegram отдаёт ≤100 за вызов,
# синк сам пейджит до капа или до курсора). Отмотать курсор для бэкфилла:
# php artisan telegram-harvest:rewind --peer=<chat_id> (без опций — листинг).
TELEGRAM_HARVEST_HISTORY_LIMIT=200
# Out-of-git стор сырья (JSONL): {lane}/{peer}/{дата}.jsonl; lane: DM→archive,
# группы/каналы→corpus. Сырьё+PII в git НЕ попадают — нормализует corpus-репо.
# ВАЖНО: указывать АБСОЛЮТНЫЙ путь, писабельный для www-data (не /root). Пусто →
# дефолт storage/app/telegram-harvest/raw.
TELEGRAM_HARVEST_STORE_PATH=
TELEGRAM_HARVEST_ACCOUNT_NAME=harvester
# Анти-бан: случайная задержка между пирами, сек (min/max). 0/0 → без пауз
# (для тестов/CI). На живом хосте ставить 3–10, чтобы не выглядеть ботом.
TELEGRAM_HARVEST_PEER_DELAY_MIN=0
TELEGRAM_HARVEST_PEER_DELAY_MAX=0
# D11 override (Track C only, @zapisi_ORSbot): пиры (@username/id), для которых
# исторический MadelineProto-бэкфилл СКАЧИВАЕТ файл медиа (не только метаданные).
# D4 metadata-only для всех остальных Track B пиров этим НЕ затрагивается.
TELEGRAM_HARVEST_MEDIA_DOWNLOAD_PEERS=

# ── Telegram Track C: второй бот-аккаунт @zapisi_ORSbot (H164) ──────────
# Класс-букинг чат, отдельный от Track B. Токен/секрет/chat_id — в админке
# (MarketingSetting), не в .env (шифруются на уровне модели). Этот флаг —
# деплой-рубильник для zapisi:send-reminders; вебхук сам fail-closed по секрету
# независимо от флага.
TELEGRAM_ZAPISI_BOT_ENABLED=false

# «Мозги» ИИ-куратора TG/VK через OpenRouter (OpenAI-совместимый шлюз).
# Пусто → бот не сможет отвечать ИИ (упадёт в мягкую ошибку «позовите куратора»).
OPENROUTER_API_KEY=
# Модель. По умолчанию DeepSeek V3. Можно сменить без правки кода.
OPENROUTER_MODEL=deepseek/deepseek-chat

# Курс валют для конвертации выплат преподавателям (PayPal, USD/EUR).
# exchangerate.host (бесплатный ключ). Пусто → авто-подтягивание курса
# выключено, курс в калькуляторе ЗП вводится вручную.
EXCHANGERATE_HOST_KEY=

# ── Эквайринг «Точка Банк» ──────────────────────────────────────────────
# Без этих переменных приём оплат/броней/пробных не работает.
TOCHKA_API_TOKEN=
TOCHKA_API_URL=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
# Код системы налогообложения и тип НДС для фискализации (чек студенту).
TOCHKA_TAX_SYSTEM_CODE=
TOCHKA_VAT_TYPE=
# Публичный ключ вебхука (для тестов/переопределения; в проде есть встроенный).
TOCHKA_WEBHOOK_PUBLIC_KEY=

# ── Оплата из-за рубежа (PayPal, полу-интегрированная) ──────────────────
# Автосписания нет: студент платит на PAYPAL_ME_LINK и подаёт заявку, админ
# сверяет вручную в админке. PAYPAL_CLAIM_ENABLED=true включает форму /paypal/*
# и кнопку на чекауте; пусто/false → роуты отдают 404.
PAYPAL_CLAIM_ENABLED=false
PAYPAL_ME_LINK=
PAYPAL_RECIPIENT=

# ── Социальная авторизация (Socialite) ─────────────────────────────────
# Пусто → провайдер не включён (кнопка не показывается).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ── VK бот / Callback API ───────────────────────────────────────────────
VK_BOT_TOKEN=
# Секрет Callback API (fail-closed: без него вебхук /api/vk-webhook отвечает 403).
VK_CALLBACK_SECRET=

# ── Секрет легаси Telegram-вебхука ──────────────────────────────────────
# fail-closed: без него вебхук /api/telegram/webhook отвечает 403. Тот же
# секрет передать в Telegram через setWebhook(secret_token=...).
TELEGRAM_BOT_WEBHOOK_SECRET=

# ── SMS.ru (резервный канал для students:send-login-invites) ───────────
# Пусто → SMS-канал выключен, скрипт молча пропускает его и падает на email.
SMS_RU_API_ID=

# ── Интеграции ──────────────────────────────────────────────────────────
# n8n: вебхук выгрузки платежей в финансовую Google-таблицу.
N8N_PAYMENTS_WEBHOOK_URL=
# Секрет для /api/sync-lessons и /api/lessons/from-zoom (hash_equals, fail-closed).
LESSON_SYNC_SECRET=
# Микросервис сборки лекций.
LECTURE_BUILDER_URL=
LECTURE_BUILDER_TOKEN=
# Пароль архива бэкапов.
BACKUP_ARCHIVE_PASSWORD=
# Off-site назначение еженедельного бэкапа: WebDAV на Яндекс.Диск.
# YANDEX_DISK_APP_PASSWORD — НЕ основной пароль аккаунта, а пароль приложения
# (тип «Диск»/WebDAV), создаётся на https://id.yandex.ru/security/app-passwords.
YANDEX_DISK_WEBDAV_URL=https://webdav.yandex.ru
YANDEX_DISK_LOGIN=
YANDEX_DISK_APP_PASSWORD=
YANDEX_DISK_BACKUP_PATH=/Backups/systema-sanscriticum
