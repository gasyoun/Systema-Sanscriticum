APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=1440

# Потолок временных загрузок Livewire (килобайты) — общий для всех полей
# админки. Держите НИЖЕ серверного post_max_size, иначе вместо внятной ошибки
# валидации человек получит голый 413. Подробности — config/livewire.php.
LIVEWIRE_UPLOAD_MAX_KB=102400

# «Дизайн курсов» (баннеры 16:9/9:16/4:3 + исходники PSD). DESIGN_MAX_PSD_KB
# ОБЯЗАН быть ниже LIVEWIRE_UPLOAD_MAX_KB — Livewire валидирует раньше, и поле
# с бо́льшим лимитом молча режет загрузки. Инвариант закрыт тестом.
DESIGN_MAX_IMAGE_KB=10240
DESIGN_MAX_PSD_KB=98304

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: mailpit catches everything, nothing leaves the machine.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Per-minute send throttle (H1449 A2) — a safety valve so a bad segment/loop
# can never blast a mailbox provider. Env-backed, never hardcode.
MAIL_THROTTLE_PER_MINUTE=30
# PRODUCTION: must NOT be the above — `php artisan mail:preflight` rejects this
# shape outside APP_ENV=local. See docs/mail-esp.md. D6 ruling (H1449): the
# default transport is a REAL MAILBOX over SMTP (mail.ru / Yandex 360), not an
# ESP — Laravel's generic `smtp` mailer already covers this with no extra
# package. The campaign engine (H1449 W1b) is transport-agnostic, so this can
# be overridden later to an ESP-as-relay (Postmark/Mailgun, already installed)
# without touching any campaign-engine code if staging deliverability is poor.
# MAIL_MAILER=smtp
# MAIL_HOST=<mailbox-smtp-host, e.g. smtp.mail.ru or smtp.yandex.ru>
# MAIL_PORT=587
# MAIL_USERNAME=<mailbox-address, e.g. noreply@yourdomain.ru>
# MAIL_PASSWORD=<mailbox-password-or-app-password>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="<verified sender on an SPF+DKIM+DMARC domain>"
# MAIL_FROM_NAME="${APP_NAME}"

# S3-совместимое объектное хранилище для тяжёлых медиа (H1345).
# Пока НЕ включено: на 19-07-2026 всё storage/app занимает ~20 МБ, выносить нечего.
# Триггеры включения и порядок переноса — docs/ROADMAP_MEDIA_STORAGE_2026_2028.md.
#
# Провайдер выбирается парой ENDPOINT+REGION, диск один (config/filesystems.php):
#   VK Cloud:  AWS_ENDPOINT=https://hb.ru-msk.vkcloud-storage.ru   AWS_DEFAULT_REGION=ru-msk
#   Yandex:    AWS_ENDPOINT=https://storage.yandexcloud.net        AWS_DEFAULT_REGION=ru-central1
# Обоим нужен AWS_USE_PATH_STYLE_ENDPOINT=true и ЗАКРЫТЫЙ bucket
# (публичный bucket = доступ к работам студентов по ссылке без проверки прав).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Слежка за ростом хранилища (H1345) — пороги в config/storage_watch.php,
# ежедневная команда `storage:check` алертит админов при выходе за них.
STORAGE_WATCH_TOTAL_MB=8000
STORAGE_WATCH_WARN_RATIO=0.8
STORAGE_WATCH_MIN_FREE_DISK_MB=2048

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Laravel Reverb (live-chat WebSocket transport, H536). Set BROADCAST_DRIVER=reverb
# and fill these once the Reverb server is deployed on the host (MG/Ivan deploy step,
# see DEPLOY_QUEUE.md). While VITE_REVERB_APP_KEY is empty the client Echo stays off.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Учётные данные суперадмина (используются DatabaseSeeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Smoke-менеджер (role=manager, узкие права CRM). НЕ super_admin — те только
# у Гасунса и Ивана. Пароль живёт только в .env (не в git); создать/обновить:
#   php artisan users:ensure-test-manager
# Вход в панель: /admin/login  (с /login менеджер уходит в кабинет студента —
# is_admin=false, это ожидаемо).
TEST_MANAGER_EMAIL=smoke-manager@samskrte.ru
TEST_MANAGER_PASSWORD=
TEST_MANAGER_NAME="Smoke Manager"

# Smoke-студент для cabinet:probe (не staff). create: php artisan users:ensure-test-student
TEST_STUDENT_EMAIL=smoke-student@samskrte.ru
TEST_STUDENT_PASSWORD=
TEST_STUDENT_NAME="Smoke Student"


# Пульс кабинета (H1777): php artisan cabinet:probe — login smoke-менеджера +
# GET /dvaram /…/admin. Крон */15. Без TEST_MANAGER_PASSWORD — no-op.
# Внешний pulse: Better Stack Heartbeat (period 15m, grace ~20). При critical
# fail уйдёт <url>/fail; при молчании алертит Better Stack. Канон:
# docs/UPTIME_BETTERSTACK_MONITORING.md
#   CABINET_PROBE_PING_URL=https://uptime.betterstack.com/api/v1/heartbeat/<TOKEN>
CABINET_PROBE_PING_URL=
CABINET_PROBE_CRON="*/15 * * * *"
# Critical TG (default ADMIN_TELEGRAM_ID). Soft hybrid-only: SOFT chat (optional).
# CABINET_PROBE_TELEGRAM_CHAT_ID=
# CABINET_PROBE_TELEGRAM_SOFT_CHAT_ID=
# CABINET_PROBE_TELEGRAM_COOLDOWN=60
# Soft-only (guards/hybrid) H2335: sticky same class until green; optional daily re-nudge.
# CABINET_PROBE_TELEGRAM_SOFT_REMINDER_HOURS=24
# 0 = once until green (quietest). Legacy SOFT_COOLDOWN minutes no longer gate re-sends.
# CABINET_PROBE_TELEGRAM_SOFT_COOLDOWN=60



# n8n webhook для выгрузки расписания в Google Таблицу (кнопка в разделе «Расписание»).

# Направление строго одностороннее: приложение шлёт снимок расписания, n8n пишет в лист.
N8N_SCHEDULE_SHEET_WEBHOOK=

# Секрет входящего вебхука «лид дошёл до шага бота» (POST /api/webhooks/lead-step).
# n8n шлёт его в заголовке X-Webhook-Secret. Пусто → эндпоинт отвечает 403 (выключен).
N8N_LEAD_STEP_SECRET=

# Секрет входящего вебхука баллов экзамена «Санка» из Google-таблицы
# (POST /api/webhooks/exam-scores, X-Webhook-Secret). Пусто → 403 (выключен).
N8N_EXAM_SCORES_SECRET=

# Клип-маркетинг (H1452): «нарежь лекцию» — исходящий вебхук в n8n (URL + секрет,
# X-Webhook-Secret) и секрет входящего callback-а (POST /api/webhooks/lecture-clip-callback).
# Флаг CLIP_MARKETING_ENABLED (config/features.php) должен быть true, иначе оба пути неактивны.
CLIP_MARKETING_ENABLED=false
N8N_CLIP_EXTRACT_WEBHOOK=
N8N_CLIP_EXTRACT_SECRET=
N8N_CLIP_CALLBACK_SECRET=

# n8n lecture content engine, Wave 1 (H1547): мастер-флаг для генерации
# ContentCandidate из лекций (ranked-span dispatch + clip→candidate sync).
# ВЫКЛ по умолчанию; не влияет на существующий CLIP_MARKETING_ENABLED-путь.
CONTENT_FROM_LECTURES=false
CONTENT_CLIP_RANK_N=5

# VK/ORS content calendar (H1564). OFF by default — DEPLOY_QUEUE №50.
# CONTENT_CALENDAR_ENABLED=true shows Filament «Календарь контента» and allows seed without --force-flag.
CONTENT_CALENDAR_ENABLED=false
# CONTENT_CALENDAR_AUTOPILOT=true enables hourly n8n publish (Wave 5 / H1568 only).
CONTENT_CALENDAR_AUTOPILOT=false
# content:publish-due webhook (Wave 5, H1568) — same shape as N8N_SOCIAL_POST_*.
N8N_CALENDAR_POST_WEBHOOK=
N8N_CALENDAR_POST_SECRET=
# Optional path to vk-ors derived CSVs (activity_by_month.csv etc.). Default: storage/app/vk_ors
# VK_ORS_DATA_PATH=

# n8n lecture content engine, Wave 2 (H1548): social pilot (VK wall + TG
# mirror) and the one-shot email scaffold. Both OFF by default.
CONTENT_AUTO_PUBLISH_PILOT=false
CONTENT_EMAIL_ONESHOT=false
N8N_SOCIAL_POST_WEBHOOK=
N8N_SOCIAL_POST_SECRET=

# Anton ops-gaps video (H1450/H1451). Both OFF by default — DEPLOY_QUEUE №46/№48.
# VIDEO_RESUME=true → «продолжить с HH:MM» via heartbeat (YouTube/RuTube; Kinescope when pilot on).
VIDEO_RESUME=false
# KINESCOPE_PILOT=true + KINESCOPE_PILOT_COURSE_ID=<Course.id> → Kinescope first-class
# host on ONE flagship course only (lesson video_url / youtube_url / rutube_url if kinescope.io).
KINESCOPE_PILOT=false
KINESCOPE_PILOT_COURSE_ID=

# Hybrid student cabinet R29 (H1481–H1582). OFF by default — R20 release gate.
# Flip only after: ≥14d Phase 0 baseline (№25 from 21-07-2026), staging
# walkthrough, MG GO. See docs/CABINET_HYBRID_PHASE4_RELEASE_PACK_2026.md +
# DEPLOY_QUEUE №52. Instant revert: CABINET_HYBRID=false + config:clear.
# CABINET_HYBRID=true → job-nav shell, recovery mode, Записи shelves, ladder.
CABINET_HYBRID=false

# Telegram (основной бот: служебные чаты — кураторы/маркетологи/онбординг).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Отдельный бот для СТУДЕНЧЕСКОГО КАБИНЕТА: привязка аккаунта, ИИ-куратор и
# личные уведомления студенту. Пусто → используется основной бот выше.
# Вебхук этого бота направить на /api/telegram/webhook.
STUDENT_TELEGRAM_BOT_TOKEN=
STUDENT_TELEGRAM_BOT_USERNAME=
# Личный chat_id админа для алертов от ассистента/ВК-бота.
ADMIN_TELEGRAM_ID=
# Chat_id общего чата кураторов: туда шлются уведомления по всем оплатам,
# броням, обещаниям и рассрочкам. Бот должен быть добавлен в этот чат.
# Пусто → curator-уведомления отключены.
TELEGRAM_CURATORS_CHAT_ID=
# Chat_id чата онбординга: «первый вход в кабинет» + еженедельная сводка
# по оплатившим, но не зашедшим. Бот должен быть добавлен в этот чат.
# Пусто → онбординг-уведомления отключены.
TELEGRAM_ONBOARDING_CHAT_ID=

# Telegram support-account analytics (Telegram Client API, MadelineProto-ready).
# Disabled by default; the dashboard can still show imported/test analytics.
TELEGRAM_SUPPORT_ENABLED=false
TELEGRAM_SUPPORT_API_ID=
TELEGRAM_SUPPORT_API_HASH=
TELEGRAM_SUPPORT_SESSION=storage/app/telegram-support/session.madeline
TELEGRAM_SUPPORT_HISTORY_LIMIT=50
TELEGRAM_SUPPORT_DIALOG_LIMIT=20
TELEGRAM_SUPPORT_PROFILE_BACKFILL_LIMIT=20
# Потолок времени одного захода синка (сек, 0 — без потолка). Требует pcntl.
# Должен оставаться заметно меньше TTL замка планировщика — тот выводится отсюда.
TELEGRAM_SUPPORT_SYNC_TIMEOUT_SECONDS=120
# Tests may override this; production should keep the default MadelineProto API.
TELEGRAM_SUPPORT_CLIENT_CLASS=
# Очередь «Техника» в Helpdesk: ЛС + учебные группы → assigned_to + вкладка.
SUPPORT_TECH_ASSIGNEE_USER_ID=
# @username или numeric id учебных чатов (через запятую), где сидит userbot.
TELEGRAM_SUPPORT_TECH_GROUP_PEERS=
# Username userbot без @ (детект @mention). Опционально.
TELEGRAM_SUPPORT_USERNAME=
# Переопределить keywords целиком (через запятую). Пусто → дефолт из config/support_tech.php.
SUPPORT_TECH_KEYWORDS=

# ── Telegram-харвестер санскрит-корпуса (Track B) ────────────────────────
# Делит ОДНУ MTProto-сессию с support-синком (TELEGRAM_SUPPORT_API_ID/HASH/
# SESSION выше). Параллельный запуск сериализуется локом 'madeline-session'
# (вторая команда выходит session_busy), но лучше не гонять их встык вручную.
# Discovery диалогов: telegram-harvest:peers.
TELEGRAM_HARVEST_ENABLED=false
# Кого харвестить: @username или numeric id через запятую (см. вывод :peers).
TELEGRAM_HARVEST_PEERS=
# Либо путь к файлу с JSON-массивом пиров (["@a", -1001234567890, ...]) — удобнее
# для длинных списков. МЁРЖИТСЯ со списком выше (не заменяет его).
TELEGRAM_HARVEST_PEERS_FILE=
# Кап сообщений за проход на пира (суммарный: Telegram отдаёт ≤100 за вызов,
# синк сам пейджит до капа или до курсора). Отмотать курсор для бэкфилла:
# php artisan telegram-harvest:rewind --peer=<chat_id> (без опций — листинг).
TELEGRAM_HARVEST_HISTORY_LIMIT=200
# Out-of-git стор сырья (JSONL): {lane}/{peer}/{дата}.jsonl; lane: DM→archive,
# группы/каналы→corpus. Сырьё+PII в git НЕ попадают — нормализует corpus-репо.
# ВАЖНО: указывать АБСОЛЮТНЫЙ путь, писабельный для www-data (не /root). Пусто →
# дефолт storage/app/telegram-harvest/raw.
TELEGRAM_HARVEST_STORE_PATH=
TELEGRAM_HARVEST_ACCOUNT_NAME=harvester
# Анти-бан: случайная задержка между пирами, сек (min/max). 0/0 → без пауз
# (для тестов/CI). На живом хосте ставить 3–10, чтобы не выглядеть ботом.
TELEGRAM_HARVEST_PEER_DELAY_MIN=0
TELEGRAM_HARVEST_PEER_DELAY_MAX=0
# D11 override (Track C only, @zapisi_ORSbot): пиры (@username/id), для которых
# исторический MadelineProto-бэкфилл СКАЧИВАЕТ файл медиа (не только метаданные).
# D4 metadata-only для всех остальных Track B пиров этим НЕ затрагивается.
TELEGRAM_HARVEST_MEDIA_DOWNLOAD_PEERS=
# Через сколько часов дашборд «Записи (бот)» помечает снимок состава чата как
# протухший (0 — не помечать). Снимок обновляет часовой roster-groups; при его
# сбое старый файл остаётся лежать и без пометки выглядит текущим.
TELEGRAM_HARVEST_ROSTER_STALE_AFTER_HOURS=6
# Через сколько часов молчания в чате дашборд предупреждает о возможной поломке
# вебхука бота (0 — не мерить). Дорожка сообщений идёт через Bot API и от
# MTProto-сессии не зависит — её молчание похоже на «в чате просто тихо».
TELEGRAM_HARVEST_CORPUS_SILENCE_AFTER_HOURS=48
# Потолок времени одного прохода roster-groups (сек, 0 — без потолка). Требует
# pcntl. Держать заметно меньше TTL замка планировщика — тот выводится отсюда.
TELEGRAM_HARVEST_ROSTER_TIMEOUT_SECONDS=600
# Track C (@zapisi_ORSbot), АВАРИЙНЫЙ приём апдейтов поллингом (zapisi:poll).
# Штатно апдейты приходят вебхуком; поллинг нужен, только когда входной узел
# недоступен. ВНИМАНИЕ: запуск снимает вебхук, поэтому дефолт false.
TELEGRAM_ZAPISI_POLL_ENABLED=false
# Сколько Telegram держит соединение в ожидании новых апдейтов; через сколько
# секунд демон планово выходит (supervisor поднимает свежий — иначе после
# деплоя останется старый код); пауза после ошибки getUpdates.
TELEGRAM_ZAPISI_POLL_TIMEOUT_SECONDS=50
TELEGRAM_ZAPISI_POLL_MAX_LIFETIME_SECONDS=3600
TELEGRAM_ZAPISI_POLL_RETRY_SECONDS=10

# ── Telegram Track C: второй бот-аккаунт @zapisi_ORSbot (H164) ──────────
# Класс-букинг чат, отдельный от Track B. Токен/секрет/chat_id — в админке
# (MarketingSetting), не в .env (шифруются на уровне модели). Этот флаг —
# деплой-рубильник для zapisi:send-reminders; вебхук сам fail-closed по секрету
# независимо от флага.
TELEGRAM_ZAPISI_BOT_ENABLED=false

# «Мозги» ИИ-куратора TG/VK через OpenRouter (OpenAI-совместимый шлюз).
# Пусто → бот не сможет отвечать ИИ (упадёт в мягкую ошибку «позовите куратора»).
OPENROUTER_API_KEY=
# Модель. По умолчанию DeepSeek V4 Flash. Можно сменить без правки кода.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Курс валют для конвертации выплат преподавателям (PayPal, USD/EUR).
# exchangerate.host (бесплатный ключ). Пусто → авто-подтягивание курса
# выключено, курс в калькуляторе ЗП вводится вручную.
EXCHANGERATE_HOST_KEY=

# ── Эквайринг «Точка Банк» ──────────────────────────────────────────────
# Без этих переменных приём оплат/броней/пробных не работает.
TOCHKA_API_TOKEN=
TOCHKA_API_URL=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
# Код системы налогообложения и тип НДС для фискализации (чек студенту).
TOCHKA_TAX_SYSTEM_CODE=
TOCHKA_VAT_TYPE=
# Публичный ключ вебхука (для тестов/переопределения; в проде есть встроенный).
TOCHKA_WEBHOOK_PUBLIC_KEY=

# H2026 Tochka recurring (modes A-E). Master OFF until human enable after money PR.
# Modes: per_course,consolidated,club,installment,multi_month (comma list).
TOCHKA_RECURRING_ENABLED=false
TOCHKA_RECURRING_MODES=per_course,club,installment

# ── Оплата из-за рубежа (PayPal, полу-интегрированная, H2017) ───────────
# Автосписания нет: студент платит на PAYPAL_ME_LINK и подаёт заявку, админ
# сверяет вручную в Filament («Заявки PayPal»). Форма требует: с какого
# PayPal + дата + сумма (txn/скрин опционально). Prod 31-07-2026: ON,
# recipient gasyoun@gmail.com, me-link paypal.me/gasyoun.
# false → /paypal/* 404, CTA скрыта.
PAYPAL_CLAIM_ENABLED=false
PAYPAL_ME_LINK=
PAYPAL_RECIPIENT=

# ── PayPal Subscriptions API (H2027, auto-bill diaspora) ───────────────
# Separate from claim. Default OFF — claim path stays the diaspora default.
# Never put real secrets in git. Prod enable = human @DO after Business
# account can sell Subscriptions. Docs: ARCHITECTURE_PAYPAL_SUBSCRIPTIONS_2026.md
PAYPAL_SUBSCRIPTIONS_ENABLED=false
PAYPAL_API_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional API host override (else mode picks api-m.sandbox / api-m.paypal.com)
PAYPAL_API_BASE_URL=

# ── Счёт для компании / ИП (безнал, H2017) ─────────────────────────────
# Форма /invoice/* + печать /invoices/{id}/print; pending → «Подтвердить счет».
# Prod 31-07-2026: ON + BILLING_* заполнены (Tochka customer / футер сайта).
# false → 404. Без BILLING_* печать показывает «реквизиты не заполнены».
# См. docs/TOCHKA_PAYMENT_METHODS_AUDIT_2026-07-31.md
COMPANY_INVOICE_ENABLED=false
BILLING_LEGAL_NAME=
BILLING_INN=
BILLING_KPP=
BILLING_OGRN=
BILLING_OGRNIP=
BILLING_LEGAL_ADDRESS=
BILLING_BANK_NAME=
BILLING_BIK=
BILLING_ACCOUNT=
BILLING_CORR_ACCOUNT=
BILLING_EMAIL=
BILLING_PHONE=

# ── Социальная авторизация (Socialite) ─────────────────────────────────
# Пусто → провайдер не включён (кнопка не показывается).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ── Yandex Metrika — shop layout (H2378 sales funnel) ───────────────────
# Public counter id for samskrte.ru (default matches ORS-FAQ ya_analytics.SAMSKRTE).
# Set YANDEX_METRIKA_SHOP_ENABLED=false to disable the tag without removing id.
YANDEX_METRIKA_SHOP_ID=106964341
YANDEX_METRIKA_SHOP_ENABLED=true

# ── VK бот / Callback API ───────────────────────────────────────────────
VK_BOT_TOKEN=
# Секрет Callback API (fail-closed: без него вебхук /api/vk-webhook отвечает 403).
VK_CALLBACK_SECRET=

# ── Секрет легаси Telegram-вебхука ──────────────────────────────────────
# fail-closed: без него вебхук /api/telegram/webhook отвечает 403. Тот же
# секрет передать в Telegram через setWebhook(secret_token=...).
TELEGRAM_BOT_WEBHOOK_SECRET=

# ── ВХОДНОЙ УЗЕЛ вебхуков Telegram (общий для ВСЕХ ботов) ───────────────
# Пусто → APP_URL, то есть «Telegram стучится прямо к нам». Заполняется, когда
# до прода Telegram не достукивается и апдейты принимает промежуточный узел
# (nginx на другом хосте + обратный SSH-туннель внутрь).
# Регистрация всех ботов разом: php artisan telegram:webhooks --set
TELEGRAM_WEBHOOK_BASE_URL=
# Сертификат этого узла, если он самоподписанный — Telegram примет такой вебхук
# только вместе с загруженным файлом. Файл должен читаться пользователем php.
# Прикладывается ТОЛЬКО когда задан TELEGRAM_WEBHOOK_BASE_URL.
TELEGRAM_WEBHOOK_CERTIFICATE=

# ── SMS.ru (резервный канал для students:send-login-invites) ───────────
# Пусто → SMS-канал выключен, скрипт молча пропускает его и падает на email.
SMS_RU_API_ID=

# ── Интеграции ──────────────────────────────────────────────────────────
# Secret Token из Zoom Event Subscriptions. Обязателен: пустой → webhook 503
# и deploy:webhook-preflight останавливает выкладку.
ZOOM_WEBHOOK_SECRET=
# Общий X-Partner-Bot-Secret. Обязателен, когда PARTNER_PROGRAM_ENABLED=true.
PARTNER_BOT_SECRET=
# n8n: вебхук выгрузки платежей в финансовую Google-таблицу.
# URL + Header Auth secret (X-Webhook-Secret) for «АДМИНКА+ТАБЛИЦА ОПЛАТ» (H1960).
# Secret must match the n8n httpHeaderAuth credential on path /webhook/payments.
N8N_PAYMENTS_WEBHOOK_URL=
N8N_PAYMENTS_WEBHOOK_SECRET=
# Секрет для /api/sync-lessons и /api/lessons/from-zoom (hash_equals, fail-closed).
LESSON_SYNC_SECRET=
# Микросервис сборки лекций.
LECTURE_BUILDER_URL=
LECTURE_BUILDER_TOKEN=
# Пароль архива бэкапов.
BACKUP_ARCHIVE_PASSWORD=
# Off-site назначение еженедельного бэкапа: WebDAV на Яндекс.Диск.
# YANDEX_DISK_APP_PASSWORD — НЕ основной пароль аккаунта, а пароль приложения
# (тип «Диск»/WebDAV), создаётся на https://id.yandex.ru/security/app-passwords.
YANDEX_DISK_WEBDAV_URL=https://webdav.yandex.ru
YANDEX_DISK_LOGIN=
YANDEX_DISK_APP_PASSWORD=
YANDEX_DISK_BACKUP_PATH=/Backups/systema-sanscriticum

# ── Пульс планировщика (Better Stack Heartbeat; not healthchecks.io) ────
# URL: https://uptime.betterstack.com/api/v1/heartbeat/<TOKEN>
# Пусто → пульс выключен, heartbeat:ping fail-open SUCCESS.
# Тревогу поднимает МОЛЧАНИЕ (period = HEARTBEAT_CRON default 5m, grace ~10m)
# + явный <url>/fail если Horizon down. docs/UPTIME_BETTERSTACK_MONITORING.md
HEARTBEAT_PING_URL=
HEARTBEAT_CRON="*/5 * * * *"
HEARTBEAT_TIMEOUT=10
# Проверять заодно, жив ли Horizon (очереди). При провале шлётся <url>/fail.
HEARTBEAT_CHECK_HORIZON=true

# ── Konsultaciya landing — visual skin switch (H1975) ───────────────────
# a|b|c|d. Orthogonal to MARATHON_LANDING_COPY_VARIANT (copy axis).
# ?skin= query override exists for QA only, never persisted.
MARATHON_LANDING_VISUAL_VARIANT=b
